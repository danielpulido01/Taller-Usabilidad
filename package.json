{
  "name": "taller-usabilidad",
  "version": "1.0.0",
  "description": "Taller de usabilidad: app de demostración Banco Aurora (v1 con problemas sembrados, v2 corregida) y pruebas con Playwright y axe-core",
  "private": true,
  "scripts": {
    "servidor:v1": "cross-env APP_VERSION=v1 vite --config vite.config.mjs",
    "servidor:v2": "cross-env APP_VERSION=v2 vite --config vite.config.mjs",
    "test:v1": "cross-env APP_VERSION=v1 playwright test --grep-invert @visual",
    "test:v2": "cross-env APP_VERSION=v2 playwright test --grep-invert @visual",
    "visual:base": "cross-env APP_VERSION=v2 SUITE=visual playwright test --grep @visual --update-snapshots",
    "visual:v1": "cross-env APP_VERSION=v1 SUITE=visual playwright test --grep @visual",
    "visual:v2": "cross-env APP_VERSION=v2 SUITE=visual playwright test --grep @visual",
    "resumen": "node scripts/resumen.js",
    "reporte": "playwright show-report reportes/html",
    "sitio": "node scripts/preparar-pages.js",
    "sus": "node scripts/sus.js estudio/resultados-sus.csv",
    "sus:ejemplo": "node scripts/sus.js estudio/ejemplo-sus-ficticio.csv"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.3.5",
    "vite": "^6.4.6"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
